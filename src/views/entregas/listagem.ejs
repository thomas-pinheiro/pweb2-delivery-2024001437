<div class="page-header">
  <h1>Entregas</h1>
  <a href="/entregas/nova" class="btn btn-primary">Nova Entrega</a>
</div>

<form method="GET" action="/entregas" class="form-group">
  <label for="status">Filtrar por status:</label>
  <select name="status" id="status" onchange="this.form.submit()">
    <option value="" <%= statusFiltro === '' ? 'selected' : '' %>>Todos</option>
    <option value="CRIADA" <%= statusFiltro === 'CRIADA' ? 'selected' : '' %>>Criada</option>
    <option value="EM_TRANSITO" <%= statusFiltro === 'EM_TRANSITO' ? 'selected' : '' %>>Em trânsito</option>
    <option value="ENTREGUE" <%= statusFiltro === 'ENTREGUE' ? 'selected' : '' %>>Entregue</option>
    <option value="CANCELADA" <%= statusFiltro === 'CANCELADA' ? 'selected' : '' %>>Cancelada</option>
  </select>
</form>

<% if (entregas.length === 0) { %>
  <p class="empty-state">Nenhuma entrega cadastrada ainda.</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Descrição</th>
        <th>Origem</th>
        <th>Destino</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% entregas.forEach(e => { %>
        <tr>
          <td><%= e.id %></td>
          <td><%= e.descricao %></td>
          <td><%= e.origem %></td>
          <td><%= e.destino %></td>
          <td><%= e.status %></td>
          <td class="actions">
            <a href="/entregas/<%= e.id %>">Ver</a>
            <!-- <a href="/entregas/<%= e.id %>/edit">Editar</a> -->
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
