<div class="page-header">
  <h1>Entregas</h1>
  <a href="/entregas/nova" class="btn btn-primary">Nova Entrega</a>
</div>

<% if (entregas.length === 0) { %>
  <p class="empty-state">Nenhuma entrega cadastrada ainda.</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr><th>Descrição</th><th>Origem</th><th>Destino</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% entregas.forEach(e => { %>
        <tr>
          <td><%= e.descricao %></td>
          <td><%= e.origem %></td>
          <td><%= e.destino %></td>
          <td><%= e.status %></td>
          <td class="actions">
            <a href="/entregas/<%= e.id %>">Ver</a>
            <!-- <a href="/entregas/<%= e.id %>/edit">Editar</a> -->
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
