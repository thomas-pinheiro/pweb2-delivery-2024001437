<div class="page-header">
  <h1>Motoristas</h1>
  <a href="/motoristas/novo" class="btn btn-primary">Novo Motorista</a>
</div>

<% if (motoristas.length === 0) { %>
  <p class="empty-state">Nenhum motorista cadastrado ainda.</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>CPF</th>
        <th>Placa do Veículo</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% motoristas.forEach(e => { %>
        <tr>
          <td><%= e.id %></td>
          <td><%= e.nome %></td>
          <td><%= e.cpf %></td>
          <td><%= e.placaVeiculo || 'Não informada' %></td>
          <td class="actions">
            <a href="/motoristas/<%= e.id %>">Ver</a>
            <!-- <a href="/motoristas/<%= e.id %>/edit">Editar</a> -->
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
